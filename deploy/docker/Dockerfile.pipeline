# deploy/docker/Dockerfile.pipeline
FROM apache/airflow:3.0.3-python3.12 AS ml-pipeline

# --- OS deps as root (venv tooling + compilers help manylibs) ---
USER root
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-venv build-essential curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create & use our own venv
USER airflow
RUN python -m venv /home/airflow/.venv
ENV VIRTUAL_ENV=/home/airflow/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Upgrade base tooling, then install mlflow
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
 && pip install --no-cache-dir mlflow==2.15.1

# Sanity check
RUN python - <<'PY'
import mlflow, sys
print("✅ mlflow installed in custom venv:", mlflow.__version__, file=sys.stderr)
PY

# (Optional) install the rest of your deps here too:
# COPY --chown=airflow:root pyproject.toml requirements.txt ./
# RUN pip install --no-cache-dir -r requirements.txt

# Your code
COPY --chown=airflow:root src/ ./src/

# Make /app importable
ENV PYTHONPATH=/app
