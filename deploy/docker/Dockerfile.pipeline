# --- STAGE 1: Build ML Pipeline Image (based on Airflow) ---
# Uses Airflow's base image so the environment matches production orchestration
# Airflow runtime with your ML libs (incl. MLflow)
FROM apache/airflow:3.0.3

USER root
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends curl pipx \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pipx install uv && pipx ensurepath
WORKDIR /app

# Python deps
COPY pyproject.toml uv.lock ./
RUN /root/.local/bin/uv pip compile pyproject.toml -o requirements.txt \
 && echo "===== requirements.txt =====" && cat requirements.txt && echo "============================" \
 && grep -Eq '(^|[[:space:]])mlflow(==|>=|$)' requirements.txt \
 && /root/.local/bin/uv pip install --requirement requirements.txt --system

# Your code (operators/utils, not DAGs)
COPY src/ ./src/

# Make your src importable by DAGs
ENV PYTHONPATH=/app

# Drop back to airflow user (official image entrypoint stays)
USER airflow

# ENTRYPOINT and CMD come from apache/airflow image

# old one from Hw2
# CMD ["python", "src/run_pipeline.py"]

