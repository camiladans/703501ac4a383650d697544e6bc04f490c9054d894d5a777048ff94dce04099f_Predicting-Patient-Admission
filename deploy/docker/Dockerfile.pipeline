# UPDATED STAGE 1
FROM apache/airflow:3.0.3

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

USER root
RUN apt-get update && apt-get install -y curl pipx && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN pipx install uv && pipx ensurepath

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN /root/.local/bin/uv pip compile pyproject.toml -o requirements.txt && \
    /root/.local/bin/uv pip install --requirement requirements.txt --system

COPY src/ ./src/

# Set as default runtime pipeline container
# ENTRYPOINT ["python", "src/run_pipeline.py"]
CMD ["python", "src/run_pipeline.py"]
