# --- STAGE 1: Build ML Pipeline Image (based on Airflow) ---
# Uses Airflow's base image so the environment matches production orchestration

FROM apache/airflow:3.0.3

# Disable Python cache and enable unbuffered output for cleaner logs
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Switch to root to install OS-level tools
USER root

# Install curl and pipx (used to install 'uv')
RUN apt-get update && apt-get install -y curl pipx && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN pipx install uv && pipx ensurepath

# Install uv using pipx for dependency resolution
WORKDIR /app

# Copy dependency files and install packages using uv
COPY pyproject.toml uv.lock ./
RUN /root/.local/bin/uv pip compile pyproject.toml -o requirements.txt && \
    /root/.local/bin/uv pip install --requirement requirements.txt --system

# Copy source code into the container
COPY src/ ./src/

# Default command to run the pipeline (overridden in Airflow container)
CMD ["python", "src/run_pipeline.py"]
