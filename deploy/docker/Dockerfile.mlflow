# Dockerfile.mlflow (fixed)
FROM python:3.12-slim

WORKDIR /app

# Minimal build deps for slim (gcc/g++ for any native wheels if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    mlflow==3.1.4 \
    psycopg2-binary==2.9.10 \
    boto3==1.40.0

# Artifact/runs directories
RUN mkdir -p /mlflow/artifacts /mlflow/runs
VOLUME ["/mlflow/artifacts"]

EXPOSE 5000

ENV MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow@postgres-mlflow:5432/mlflow \
    MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts \
    MLFLOW_HOST=0.0.0.0 \
    MLFLOW_PORT=5000

CMD ["sh","-c","mlflow server --backend-store-uri $MLFLOW_BACKEND_STORE_URI --default-artifact-root $MLFLOW_DEFAULT_ARTIFACT_ROOT --host $MLFLOW_HOST --port $MLFLOW_PORT"]
