# Base image: Apache Airflow official image for consistency in ML orchestration
FROM apache/airflow:3.0.3

# Switched to root so we can run some quick OS updates and binary copy for uv
USER root
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /bin/uv

# Install system dependencies required for ML libraries (e.g., libgomp1 for OpenMP in lightgbm or scikit-learn)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Set /opt/airflow as working directory, mimicking the regular base airflow image
WORKDIR /opt/airflow

# Copy project metadata
COPY --chown=airflow:root pyproject.toml uv.lock /opt/airflow/

# ---- Airflow constraints (match your Airflow & Python) ----
ARG AIRFLOW_VERSION=3.0.3
ARG PYTHON_VERSION=3.12
ENV AIRFLOW_CONSTRAINTS_URL="https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt"

# Export locked deps, then install them UNDER Airflow constraints
RUN uv export --locked --format requirements-txt --no-dev --output-file /tmp/requirements.txt && chown airflow:root /tmp/requirements.txt

# We switch back to airflow user for package installation to user site-packages
USER airflow

# Install Python deps UNDER Airflow constraints (no root pip!)
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
      -r /tmp/requirements.txt
